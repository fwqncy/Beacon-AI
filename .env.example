# Required: your Claude API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Postgres with the pgvector extension. The database is created on first run.
DATABASE_URL=postgresql://localhost/arachne_app

# Optional tuning
# ARACHNE_MODEL=claude-opus-5-5
# ARACHNE_EFFORT=low          # low | medium | high
# ARACHNE_TOP_K=6             # passages retrieved per question
# ARACHNE_MIN_SCORE=0.55      # cosine similarity floor; below it Arachne says it found nothing
# ARACHNE_COOKIE_SECURE=true  # set when serving over HTTPS

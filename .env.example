# Required: your Claude API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Postgres with the pgvector extension. The database is created on first run.
DATABASE_URL=postgresql://localhost/beacon_app

# Optional tuning
# BEACON_MODEL=claude-opus-5-5
# BEACON_EFFORT=low          # low | medium | high
# BEACON_TOP_K=6             # passages retrieved per question
# BEACON_MIN_SCORE=0.55      # cosine similarity floor; below it Beacon says it found nothing
# BEACON_COOKIE_SECURE=true  # set when serving over HTTPS
